{
  "manufacturer": "bird-spec",
  "keyboard_name": "phantom_pad",
  "maintainer": "bird-spec",
  "processor": "RP2040",
  "bootloader": "rp2040",
  "url": "https://github.com/bird-spec/phantom-pad",
  "usb": { "vid": "0xFEED", "pid": "0x0001", "device_version": "0.0.1" },

  "_comment_pins": [
    "XIAO RP2040 silkscreen -> GPIO:",
    "D0=GP26 D1=GP27 D2=GP28 D3=GP29 D4=GP6 D5=GP7",
    "D6=GP0  D7=GP1  D8=GP2  D9=GP4  D10=GP3",
    "Rows are D0-D2, columns D3-D6, encoders take the rest."
  ],
  "matrix_pins": {
    "rows": ["GP26", "GP27", "GP28"],
    "cols": ["GP29", "GP6", "GP7", "GP0"]
  },
  "diode_direction": "COL2ROW",

  "encoder": {
    "rotary": [
      { "pin_a": "GP1", "pin_b": "GP2" },
      { "pin_a": "GP4", "pin_b": "GP3" }
    ]
  },
  "features": {
    "encoder": true,
    "bootmagic": true,
    "extrakey": true,
    "nkro": true,
    "console": false,
    "command": false,
    "mousekey": false
  },

  "layouts": {
    "LAYOUT": {
      "layout": [
        { "matrix": [0, 0], "x": 0, "y": 0 },
        { "matrix": [0, 1], "x": 1, "y": 0 },
        { "matrix": [0, 2], "x": 2, "y": 0 },
        { "matrix": [0, 3], "x": 3, "y": 0 },

        { "matrix": [1, 0], "x": 0, "y": 1 },
        { "matrix": [1, 1], "x": 1, "y": 1 },
        { "matrix": [1, 2], "x": 2, "y": 1 },
        { "matrix": [1, 3], "x": 3, "y": 1 },

        { "matrix": [2, 0], "x": 0, "y": 2 },
        { "matrix": [2, 1], "x": 1, "y": 2 },
        { "matrix": [2, 2], "x": 2, "y": 2 },
        { "matrix": [2, 3], "x": 3, "y": 2 }
      ]
    }
  }
}
